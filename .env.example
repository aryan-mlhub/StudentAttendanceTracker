# =============================================================================
# STUDENT ATTENDANCE TRACKER - ENVIRONMENT CONFIGURATION
# =============================================================================

# Flask Application Secret Key (generate a secure random string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Hosted PostgreSQL Database Connection URL (e.g., from Neon.tech)
# Format: postgresql://[user]:[password]@[endpoint-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require
